{
  "name": "@oakzhong/dsh-mysql-client",
  "version": "1.1.1",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "A MySQL client with connection management, query tabs and SQL execution.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "icon.png",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "mysql2": "^3.24.6",
    "@types/node": "^22.0.0"
  }
}
